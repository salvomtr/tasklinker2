{% extends 'base.html.twig' %}

{% block title %}Modifier un employé{% endblock %}
{% block page_title %}Modifier {{ employe.prenom }} {{ employe.nom }}{% endblock %}

{% block body %}
    {{ form_start(form) }}

    {{ form_row(form.nom, {'label': 'Nom'}) }}
    {{ form_row(form.prenom, {'label': 'Prénom'}) }}
    {{ form_row(form.email, {'label': 'E-mail'}) }}
    {{ form_row(form.dateEntree, {'label': 'Date d’entrée'}) }}
    {{ form_row(form.statut, {'label': 'Statut'}) }}

    <button class="button button-submit">Enregistrer</button>

    {{ form_end(form) }}
{% endblock %}
