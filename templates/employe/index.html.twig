{% extends 'base.html.twig' %}

{% block title %}Équipe{% endblock %}
{% block page_title %}Équipe{% endblock %}

{% block body %}
    <table id="team-container">
        <thead>
        <tr>
            <th>Prénom, Nom</th>
            <th>Statut</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for employe in employes %}
            <tr>
                <td>
                    <div class="employee-infos">
                        <div class="employee-avatar">
                            {{ employe.prenom|slice(0,1)|upper ~ employe.nom|slice(0,1)|upper }}
                        </div>
                        <div class="employee-coords">
                            <strong>{{ employe.prenom }} {{ employe.nom }}</strong>
                            <span>{{ employe.email }}</span>
                        </div>
                    </div>
                </td>
                <td>{{ employe.statut }}</td>
                <td>
                    <a href="{{ path('app_employe_edit', { id: employe.id }) }}" class="button button-edit-team">Éditer</a>
                    <a href="{{ path('app_employe_delete', { id: employe.id }) }}" class="delete-team">Supprimer</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
